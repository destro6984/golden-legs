{
  "name": "golden-legs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @golden-legs/app",
    "build": "npm run build -w @golden-legs/app",
    "start": "npm run start -w @golden-legs/app",
    "lint": "npm run lint -w @golden-legs/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run migration:up -w @golden-legs/db",
    "db:migration:create": "npm run migration:create -w @golden-legs/db"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
