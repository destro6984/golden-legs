{
  "name": "golden-legs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @golden-legs/app",
    "build": "npm run build -w @golden-legs/app",
    "start": "npm run start -w @golden-legs/app",
    "lint": "eslint packages && npm run lint -w @golden-legs/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.mts",
    "app:ephemeral": "npm run build && tsx packages/app/tests/support/run-ephemeral-app.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run migration:up -w @golden-legs/db",
    "db:migration:create": "npm run migration:create -w @golden-legs/db"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.5",
    "agent-browser": "^0.41.0",
    "eslint": "^9.39.5",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
